# このファイルを .env にコピーして値を設定してください: cp .env.example .env

# Prisma(SQLite)のDBファイルの場所。基本このままでOK
DATABASE_URL="file:./dev.db"

# NewsAPI.org のAPIキー(必須: 記事取得機能を使う場合)
# https://newsapi.org/register で無料登録すると取得できます
# 無料枠: 開発用途のみ / 過去1ヶ月の記事 / 1日100リクエスト程度 / 出典表示が必要
NEWSAPI_KEY=

# Anthropic APIキー(任意: あると記事からのクイズ生成の品質が上がる)
# https://console.anthropic.com で取得。従量課金
# 未設定の場合は無料の簡易ロジック(頻度ベース語彙抽出+穴埋め問題)で動作します
ANTHROPIC_API_KEY=

# クイズ生成に使うClaudeモデル(任意。デフォルト: claude-sonnet-5)
# Sonnet 5 + 下のCLAUDE_EFFORT=xhigh の組み合わせで上位モデルに迫る品質が出ます
# コスト重視なら CLAUDE_EFFORT=medium に下げるのが先。モデル自体の変更は
# effort/adaptive thinking対応モデル(Sonnet 5 / Opus 4.6以降 / Fable 5)を指定してください
CLAUDE_MODEL=

# 思考の深さ(任意。デフォルト: xhigh): low | medium | high | xhigh | max
# 深いほど高品質・高コスト・高レイテンシ。記事1件あたりのコストが気になる場合は medium 推奨
CLAUDE_EFFORT=
